#!/usr/bin/make -f
# Packaging for code-on-incus (coi).
#
# The offline Launchpad builders have no network, so Go modules are vendored
# (vendor/, generated by `go mod vendor` before building) and GOPROXY is off.
# Go 1.25 is not in the LTS archives; it comes from ppa:longsleep/golang-backports,
# which must be added as an "archive dependency" of your PPA (see debian/README.source).

export DH_VERBOSE = 1

# Use the versioned Go 1.25 toolchain from golang-1.25-go, not the distro default.
export PATH := /usr/lib/go-1.25/bin:$(PATH)
export GOTOOLCHAIN := local
export GOFLAGS := -mod=vendor
export GOPROXY := off
export GOCACHE := $(CURDIR)/_build/go-cache
export GOPATH := $(CURDIR)/_build/gopath
# coi uses cgo to read the systemd journal (needs libsystemd-dev + pkg-config).
export CGO_ENABLED := 1

IMPORT := github.com/mensfeld/code-on-incus
VERSION := $(shell dpkg-parsechangelog -SVersion | sed 's/[~-].*//')

%:
	dh $@

# Replicate the upstream Makefile `build` target: stage the go:embed assets,
# then build the single cmd/coi binary with the version stamped in.
override_dh_auto_build:
	mkdir -p internal/image/embedded internal/config/embedded
	cp profiles/default/config.toml internal/config/embedded/default_config.toml
	cp testdata/dummy/dummy internal/image/embedded/dummy
	go build -trimpath -mod=vendor \
		-ldflags "-s -w -X $(IMPORT)/internal/cli.Version=$(VERSION)" \
		-o coi ./cmd/coi

# Integration tests need a live Incus daemon; not runnable on a builder.
override_dh_auto_test:

# Go binaries strip clean with -s -w above; dwz cannot compress Go DWARF and errors.
override_dh_dwz:

override_dh_auto_install:
	install -D -m0755 coi debian/code-on-incus/usr/bin/coi

override_dh_auto_clean:
	# Only remove generated/untracked artifacts. internal/config/embedded/
	# default_config.toml is tracked upstream, so it is left in place.
	rm -rf _build coi internal/image/embedded
